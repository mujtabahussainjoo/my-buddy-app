# =============================================================================
# MyAIBuddy - Unified Configuration
# =============================================================================
# Copy this file to .env and customize. This single file controls:
#   - Docker Compose (local + production)
#   - Frontend (Vite dev server + production build)
#   - Backend (FastAPI + all services)
#   - Database (PostgreSQL)
#
# Usage:
#   cp .env.example .env
#   docker compose up -d          # Start everything
#   make setup                    # Or use make
#
# NOTE: Keep values on their own lines (no inline comments) so the Makefile and
# setup.sh can parse this file reliably.
# =============================================================================

# ------------------------- General -------------------------------------------
APP_NAME=MyAIBuddy
APP_ENV=production
# Public URL where the app is accessible
APP_URL=http://localhost:8080
LOG_LEVEL=INFO

# ------------------------- Ports ---------------------------------------------
# Change these to avoid conflicts with other services on your machine.
FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_PORT=5433

# ------------------------- Database ------------------------------------------
# POSTGRES_HOST: service name in docker-compose (use 127.0.0.1 for local)
POSTGRES_HOST=db
# POSTGRES_PORT: container-internal port (do NOT change for docker)
POSTGRES_PORT=5432
POSTGRES_DB=myaibuddy
POSTGRES_USER=myaibuddy
POSTGRES_PASSWORD=myaibuddy_dev
# Full connection string overrides POSTGRES_* parts (leave empty to auto-derive)
DATABASE_URL=

# ------------------------- Authentication ------------------------------------
# REQUIRED for production. Auto-generated in development.
# This value also ENCRYPTS the AI provider API keys you save in Settings, so it
# must never change once you have saved a key — a change makes every saved key
# unreadable ("credential_undecryptable") and signs everyone out.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development, if this is empty the app generates one and saves it to
# apps/backend/var/dev-jwt-secret so it stays the same across restarts.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------- CORS ----------------------------------------------
# Comma-separated origins allowed to call the API.
# Docker: http://localhost:8080  |  Local dev: http://localhost:5173
CORS_ORIGINS=http://localhost:8080

# ------------------------- AI Provider Keys ----------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_API_TOKEN=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ------------------------- Search / External Tools ---------------------------
TAVILY_API_KEY=
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=

# ------------------------- Image Generation (optional) -----------------------
STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# ------------------------- Observability -------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=myaibuddy
SENTRY_DSN=

# ------------------------- MCP -----------------------------------------------
MCP_SERVER_URLS=
MCP_AUTH_TOKEN=

# ------------------------- RAG / Embeddings ----------------------------------
# One of: keyword | openai | huggingface | ollama
EMBEDDING_PROVIDER=keyword
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=700
CHUNK_OVERLAP=70
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.10
RETRIEVAL_CHUNKS_PER_DOC=2
RETRIEVAL_MAX_CONTEXT_CHARS=12000
# Messages have no length limit. Anything bigger than this many characters is
# trimmed (start and end kept) so it still fits the model's context window.
LLM_MAX_INPUT_CHARS=400000
MAX_UPLOAD_MB=50
MAX_UPLOAD_FILES=20
UPLOAD_DIR=var/uploads

# ------------------------- Rate Limiting -------------------------------------
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=15/minute

# ------------------------- Frontend ------------------------------------------
# Backend API URL for standalone frontend deploys (e.g. Render, AWS).
# Leave empty when using docker-compose (Nginx proxies to the backend).
VITE_API_BASE_URL=